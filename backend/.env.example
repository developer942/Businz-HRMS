# ==============================================================================
# VRM Enterprise HRMS - Payroll Backend Environment Variables
# ==============================================================================

PORT=8000
NODE_ENV=development

# VPS-hosted database REST API.
# Keep this pointing to the local/VPS PostgREST proxy.
DB_REST_URL=http://localhost:3001
DB_REST_KEY=vps-local-rest-key
DB_REST_SERVICE_KEY=vps-local-rest-key

# JWT Secret for Session Verification
JWT_SECRET=vrm-hrms-dev-jwt-secret-key-replace-in-production-2026

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Direct PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms
DATABASE_SSL=false

# Outbound HRMS email (forgot password OTP + employee credentials / offer letters)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=developer@businz.com
SMTP_PASS=change-this-smtp-password
SMTP_FROM="Businz HRMS" <developer@businz.com>

# Built-in emergency super admin password for VPS env only. Never commit the real value.
SYSTEM_SUPER_ADMIN_PASSWORD=change-this-super-admin-password

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=25000
